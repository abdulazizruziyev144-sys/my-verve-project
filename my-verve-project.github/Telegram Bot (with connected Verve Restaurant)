USER_STATE = {}


def get_user_session(user_id: int) -> dict:
    if user_id not in USER_STATE:
        USER_STATE[user_id] = {
            "lang": "uz",
            "cart": {},
            "points": 0,
            "phone": None,
            "location": None
        }
    return USER_STATE[user_id]


